{
  "name": "agentgem-desktop",
  "version": "0.4.0",
  "private": true,
  "description": "Native desktop host for AgentGem",
  "author": "ninemind.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ninemindai/agentgem.git"
  },
  "main": "dist/main.js",
  "scripts": {
    "build:core": "pnpm -C .. build",
    "build": "tsc -p .",
    "bundle:core": "node scripts/bundle-core.mjs",
    "bundle-adapters": "node scripts/bundle-adapters.mjs",
    "dev": "pnpm build:core && pnpm build && cross-env AGENTGEM_DEV=1 electron dist/main.js",
    "dist": "pnpm build:core && pnpm build && pnpm bundle:core && pnpm bundle-adapters && electron-builder --publish never",
    "release": "pnpm build:core && pnpm build && pnpm bundle:core && pnpm bundle-adapters && electron-builder --publish always",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.1",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
