{
  "name": "@agentgem/aggregator",
  "version": "0.3.1",
  "description": "Postgres/pglite data-moat — schema, aggregates, ingest, detection, account binding.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/auth/testCookie.d.ts",
      "default": "./dist/auth/testCookie.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "default": "./dist/catalog.js"
    },
    "./webAuth": {
      "types": "./dist/webAuth.d.ts",
      "default": "./dist/webAuth.js"
    },
    "./handles": {
      "types": "./dist/handles.d.ts",
      "default": "./dist/handles.js"
    },
    "./binding": {
      "types": "./dist/binding.d.ts",
      "default": "./dist/binding.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@agentgem/contract": "workspace:*",
    "@agentgem/insight": "workspace:*",
    "@agentgem/model": "workspace:*",
    "@better-auth/passkey": "^1.6.23",
    "@electric-sql/pglite": "^0.5.4",
    "better-auth": "^1.6.23",
    "drizzle-orm": "^0.45.2"
  }
}
