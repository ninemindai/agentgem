// Cloudflare Worker that serves the public marketplace SPA (app.agentgem.ai) from
// Workers Static Assets, fronted by src/worker.ts, which injects per-route OG/
// unfurl tags (e.g. for shared game gems) before delegating to env.ASSETS.fetch
// for the actual asset bytes + SPA fallback.
//
// run_worker_first = true (below) is REQUIRED for the injection: by default
// Cloudflare serves a matching static asset directly and never invokes the
// Worker, so the OG-injection branch would be dead code. With it true the
// Worker runs first on every request, then serves the asset via env.ASSETS
// for the normal case.
//
// Deployed by .github/workflows/deploy-worker.yml, which builds dist/ with
// VITE_API_BASE=https://api.agentgem.ai first.
//
// CUTOVER (Render → Cloudflare), in order:
//   1. In the Cloudflare dashboard (agentgem.ai zone), delete the existing
//      app.agentgem.ai CNAME that points at Render — a Worker Custom Domain
//      409-conflicts with any pre-existing record (see website/edge/wrangler.toml).
//   2. Uncomment "routes" below and set "workers_dev" to false; push. The deploy
//      provisions the proxied DNS record + edge cert automatically.
//   3. Verify on https://app.agentgem.ai: sign-in, star, review (cookies/CORS are
//      origin-exact; the origin doesn't change, so they should be untouched).
//   4. Retire the agentgem-app static site: remove it from render.yaml and delete
//      the service in the Render dashboard so it can't serve stale builds.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "agentgem-app",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-23",
  "account_id": "8c60d6f6b0408a55768ec315042db967",

  // No *.workers.dev URL — this Worker only runs on its custom domain (below).
  // custom_domain = true makes `wrangler deploy` provision the proxied DNS record
  // and edge cert (the old Render CNAME was deleted first; see CUTOVER above).
  "workers_dev": false,
  "routes": [{ "pattern": "app.agentgem.ai", "custom_domain": true }],

  // Hosted aggregator base URL, no trailing slash. The Worker reads this to
  // fetch share/gem metadata server-to-server when building OG tags.
  "vars": { "AGGREGATOR_API": "https://api.agentgem.ai" },

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}
